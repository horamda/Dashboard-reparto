DATABASE_URL=postgresql://usuario:clave@host:5432/base
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Rendimiento
PGCONNECT_TIMEOUT=10
PGSTATEMENT_TIMEOUT_SECONDS=60
PG_POOL_MAX=5
PG_INSERT_PAGE_SIZE=500
STORAGE_CACHE_TTL_SECONDS=300
STORAGE_CACHE_MAX_ITEMS=128
PEDIDOS_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=30
EXTERNAL_DATA_CACHE_TTL_SECONDS=300
EXTERNAL_REQUEST_TIMEOUT_SECONDS=8
GZIP_CACHE_MAX_ITEMS=4
GZIP_CACHE_MIN_BYTES=262144

# Ruteo vial. El valor por defecto usa el servicio publico de OSRM.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=8
ROUTING_MAX_COORDINATES=100

# Integraciones opcionales
FICHAYA_API_BASE_URL=https://control-asistencia.up.railway.app
# web: login y descarga CSV; api: API externa; auto: web y luego API.
FICHAYA_INTEGRATION_MODE=web
FICHAYA_WEB_USERNAME=
FICHAYA_WEB_PASSWORD=
# Lectura en modo api/auto y envío de KPIs (también si las fichadas usan modo web).
# Deben ser credenciales del usuario técnico de la API externa.
FICHAYA_API_USERNAME=
FICHAYA_API_PASSWORD=
# El backend receptor debe habilitar EXTERNAL_API_KPI_WRITE_ENABLED=1.
# Empresa, sector y códigos de Operaciones se revisan en /kpis-fichaya.

# API logistica v1 de DashboardDiasPico. La clave debe coincidir con
# INTEGRATION_API_KEY del servicio productor.
LOGISTICS_INTEGRATION_API_BASE_URL=https://web-production-f968ec.up.railway.app
LOGISTICS_INTEGRATION_API_KEY=

# API de distancias para Costo por PDV en Dias Pico (Bearer).
# Si se omite, utiliza LOGISTICS_INTEGRATION_API_KEY.
PDV_COST_API_KEY=
LOGISTICS_INTEGRATION_EMPRESA_ID=1
LOGISTICS_INTEGRATION_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
