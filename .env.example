DATABASE_URL=postgresql://usuario:clave@host:5432/base
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Rendimiento
PGCONNECT_TIMEOUT=10
PGSTATEMENT_TIMEOUT_SECONDS=60
PG_POOL_MAX=5
PG_INSERT_PAGE_SIZE=500
STORAGE_CACHE_TTL_SECONDS=300
STORAGE_CACHE_MAX_ITEMS=128
PEDIDOS_CACHE_TTL_SECONDS=300
DASHBOARD_CACHE_TTL_SECONDS=30
EXTERNAL_DATA_CACHE_TTL_SECONDS=900
EXTERNAL_REQUEST_TIMEOUT_SECONDS=8
GZIP_CACHE_MAX_ITEMS=4
GZIP_CACHE_MIN_BYTES=262144

# Ruteo vial. El valor por defecto usa el servicio publico de OSRM.
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=8
ROUTING_MAX_COORDINATES=100

# Integraciones opcionales
FICHAYA_API_BASE_URL=https://control-asistencia.up.railway.app
FICHAYA_API_USERNAME=
FICHAYA_API_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
